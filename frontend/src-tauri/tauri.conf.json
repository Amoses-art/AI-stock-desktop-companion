{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "股大师",
  "version": "0.7.0",
  "identifier": "com.gudashi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "股大师",
        "width": 240,
        "height": 220,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": false,
        "visible": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://localhost:*;",
      "dangerousDisableAssetCspModification": false
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend": "backend/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "../installer-hooks.nsi"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
